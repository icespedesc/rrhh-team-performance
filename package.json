{
  "name": "evaluacion-desempeno-app",
  "version": "1.4.16",
  "private": true,
  "description": "Desktop app for offline performance feedback preparation and team ranking.",
  "main": "dist-electron/main.js",
  "author": "",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:pwa": "vite --host 127.0.0.1",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "tsc -p tsconfig.node.json --watch",
    "dev:electron": "wait-on tcp:5173 dist-electron/main.js && nodemon --watch dist-electron --ext js --exec \"cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run build:renderer && npm run build:main",
    "build:pwa": "vite build",
    "build:pages": "npm run build:pwa",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "dist:pwa": "npm run build:pwa && cd dist && bestzip ../evaluacion-desempeno-pwa-$npm_package_version.zip *",
    "generate:icons": "node scripts/generate-icons.mjs",
    "lint": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.38.0",
    "better-sqlite3": "^11.10.0",
    "chart.js": "^4.5.1",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "bestzip": "^2.2.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dmg-builder": "^26.8.1",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.10",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "cl.jefaturas.evaluacion.desempeno",
    "productName": "Evaluacion de Desempeno",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.sqlite",
      "!**/*.sqlite-shm",
      "!**/*.sqlite-wal",
      "!**/*.db"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "assets/icons/generated/icon.icns",
      "target": "zip"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/generated/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/generated/png/512x512.png"
    }
  }
}
